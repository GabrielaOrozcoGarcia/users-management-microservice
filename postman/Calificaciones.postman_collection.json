    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://calificaciones-gorozco.onrender.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin1234!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "calificacionId",
      "value": ""
    }
  ],
